{
  "name": "nuxt-cms-core",
  "version": "0.0.1",
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./config": "./src/config.ts",
    "./types": "./app/types/index.ts"
  },
  "bin": {
    "nuxt-cms": "./bin/nuxt-cms.mjs"
  },
  "files": [
    "app",
    "bin",
    "src",
    "supabase/migrations",
    "nuxt.config.ts"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "dev": "nuxi dev playground",
    "build": "nuxi build playground",
    "check:bundle": "node scripts/check-public-bundle.mjs",
    "preview": "nuxi preview playground",
    "test": "vitest run",
    "test:db": "supabase test db",
    "typecheck": "nuxi typecheck playground && tsc -p src",
    "lint": "eslint .",
    "gen:types": "supabase gen types typescript --local --schema public > app/data/database.types.ts.tmp && mv app/data/database.types.ts.tmp app/data/database.types.ts",
    "prepare": "nuxi prepare playground"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@iconify-json/lucide": "^1.2.152",
    "@nuxt/icon": "^2.6.2",
    "@nuxt/kit": "^4.5.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tiptap/vue-3": "^3.34.0",
    "@vueuse/core": "^15.0.0",
    "c12": "^3.3.4",
    "vee-validate": "^4.15.1"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@types/node": "^22.20.4",
    "eslint": "^10.15.0",
    "nuxt": "^4.5.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  }
}
