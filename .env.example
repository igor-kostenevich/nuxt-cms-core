# CMS Core reads its backend connection from the environment, never from cms.config.ts.
# The same code targets a local Supabase CLI instance or a hosted project:
# only these two values change.

# Local development (`supabase start` prints both values via `supabase status`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=

# Hosted project
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_KEY=<publishable-or-anon-key>

# Only the publishable/anon key belongs here: it is exposed to the browser and
# protected by Row Level Security. Never put the secret/service_role key in it.

# The values above are build-time defaults. When the build and the runtime are
# different environments (any hosted deployment), set these at runtime instead,
# using Nuxt's own override convention:
#
#   NUXT_PUBLIC_CMS_SUPABASE_URL=
#   NUXT_PUBLIC_CMS_SUPABASE_KEY=

# Server-only secret key (forms, 011). Never exposed to the browser and never
# read at build time: set it at runtime on the server.
#   Local: `supabase status` → "Secret" key (sb_secret_…), or the legacy service_role key.
#   Hosted: Project Settings → API keys → secret key.
# NUXT_CMS_SUPABASE_SECRET is the Nuxt runtime override; SUPABASE_SECRET also works.
SUPABASE_SECRET=
# NUXT_CMS_SUPABASE_SECRET=

# Where the visitor address for the form rate limits comes from (runtime):
#   auto (default) · none · socket · vercel · cloudflare · proxy[:N]
# See README → "Visitor address (form limits)". No header is trusted by default.
# NUXT_CMS_CLIENT_ADDRESS=auto
